    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұлы Көш қадам мен жүрілген қашықтықты оқып, оларды ауылыңыздың жол шақырымына айналдырады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұлы Көш читает шаги и пройденное расстояние, чтобы превращать их в километры пути вашего аула."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қолданба «Денсаулыққа» дерек жазбайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение не записывает данные в Здоровье."
