    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұлы Көш қадам мен жүрілген қашықтықты оқып, оларды жолаушыңыздың жол шақырымына айналдырады."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұлы Көш читает шаги и пройденное расстояние, чтобы превращать их в километры пути вашего путника."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қолданба «Денсаулыққа» дерек жазбайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение не записывает данные в Здоровье."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұлы Көш қазір тұрған жеріңіздегі ауа райын көрсетеді және жолдың басы ретінде ең жақын қаланы ұсынады. Орналасқан жер сақталмайды."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ұлы Көш показывает погоду там, где вы сейчас, и предлагает ближайший город как начало пути. Местоположение не сохраняется."
          }
        }
      }
    }
  },
  "version" : "1.0"
}