            "value": "· %@"
          }
        }
      }
    },
    "· %@ жителей": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "· %@ тұрғын"
          }
        }
      }
    },
    "/%lld": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "/%lld"
          }
        }
      }
    },
    "%@ — город, %@. Здесь можно отдохнуть, пополнить запасы и узнать дорогу дальше.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – қала, %@. Мұнда демалып, азық толықтырып, әрі қарайғы жолды сұрап білуге болады."
          }
        }
      }
    },
    "%@ — районный центр, %@. На базаре путнику продадут лепёшки в дорогу и расскажут, где лучше заночевать.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – аудан орталығы, %@. Базарда жолаушыға жолға нан сатып, қай жерде түнеген дұрыс екенін айтады."
          }
        }
      }
    },
    "%@ — село, %@. Путника здесь встречают чаем и расспросами о дороге.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – ауыл, %@. Жолаушыны мұнда шаймен және жол туралы сұрақтармен қарсы алады."
          }
        }
      }
    },
    "%@ — столица Казахстана. Широкие проспекты, новые кварталы и ветер из степи, который здесь дует круглый год.": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ – Қазақстанның астанасы. Кең даңғылдар, жаңа ықшамаудандар және мұнда жыл бойы соғатын дала желі."
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
